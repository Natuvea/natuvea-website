---
import '../styles/global.css';

interface Props {
  /** Document <title>. */
  title: string;
  /** Meta description; omitted for pages that should not be indexed. */
  description?: string;
  /** Site-relative path used for the canonical and og:url, e.g. "/product.html". */
  path?: string;
  /** Page is not indexed and carries no canonical or Open Graph tags. */
  noindex?: boolean;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: 'website' | 'article';
  /** Extra JSON-LD to embed, already as a plain object. */
  jsonLd?: Record<string, unknown>;
  /** Class applied to <body>: "home" for the hero layout, "page" for prose. */
  bodyClass: 'home' | 'page';
}

const {
  title,
  description,
  path,
  noindex = false,
  ogTitle = title,
  ogDescription = description,
  ogType = 'website',
  jsonLd,
  bodyClass,
} = Astro.props;

const canonical = path ? new URL(path, Astro.site).href : undefined;
const ogImage = new URL('/og-image.png', Astro.site).href;
const fontHref =
  'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&display=swap';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  {description && <meta name="description" content={description}>}
  <meta name="robots" content={noindex ? 'noindex' : 'index, follow'}>
  {canonical && <link rel="canonical" href={canonical}>}

  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#1d1d1b">

  <link rel="preload" href={fontHref} as="style">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href={fontHref} rel="stylesheet">

  {!noindex && (
    <>
      <meta property="og:type" content={ogType}>
      {canonical && <meta property="og:url" content={canonical}>}
      <meta property="og:title" content={ogTitle}>
      {ogDescription && <meta property="og:description" content={ogDescription}>}
      <meta property="og:image" content={ogImage}>
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="630">
      <meta property="og:site_name" content="Natuvea">
      <meta name="twitter:card" content="summary_large_image">
      <meta name="twitter:title" content={ogTitle}>
      {ogDescription && <meta name="twitter:description" content={ogDescription}>}
      <meta name="twitter:image" content={ogImage}>
    </>
  )}

  {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body class={bodyClass}>
  <slot />
</body>
</html>
